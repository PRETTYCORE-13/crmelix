<div class="flex h-[calc(100vh-4rem)] bg-white overflow-hidden">

  <%!-- Panel izquierdo: lista de esquema --%>
  <aside class="w-56 shrink-0 border-r border-gray-200 flex flex-col">
    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
      <span class="text-sm font-semibold text-gray-700">Esquemas</span>
      <button phx-click="nuevo_modelo" title="Nuevo modelo"
        class="text-indigo-600 hover:text-indigo-800 text-xl font-bold leading-none">+</button>
    </div>
    <nav class="flex-1 overflow-y-auto">
      <%= if @esquema == [] do %>
        <p class="px-4 py-6 text-xs text-gray-400 text-center">
          Sin esquema.<br/>Presiona + para crear uno.
        </p>
      <% else %>
        <%= for m <- @esquema do %>
          <button
            phx-click="seleccionar" phx-value-id={m.id}
            class={[
              "w-full text-left px-4 py-2.5 border-b border-gray-100 hover:bg-indigo-50 transition-colors",
              @modelo && @modelo.id == m.id &&
                "bg-indigo-50 border-l-2 border-l-indigo-500" || ""
            ]}
          >
            <div class="flex items-center gap-1.5">
              <span class={["text-sm font-medium", @modelo && @modelo.id == m.id && "text-indigo-700" || "text-gray-800"]}>
                <%= m.nombre %>
              </span>
              <%= cond do %>
                <% MapSet.member?(@local_ids, m.id) -> %>
                  <span title="Borrador local (no guardado en BD)" class="w-2 h-2 rounded-full bg-yellow-400 shrink-0"></span>
                <% m.tabla_creada -> %>
                  <span title="Tabla creada en BD" class="w-2 h-2 rounded-full bg-green-400 shrink-0"></span>
                <% true -> %>
                  <span title="Tabla NO creada" class="w-2 h-2 rounded-full bg-gray-300 shrink-0"></span>
              <% end %>
            </div>
            <div class="text-xs text-gray-400 truncate"><%= m.tabla_db %></div>
          </button>
        <% end %>
      <% end %>
    </nav>
  </aside>

  <%!-- Panel derecho --%>
  <main class="flex-1 overflow-y-auto flex flex-col min-w-0">

    <%= if @modelo_form do %>
      <%!-- Formulario nuevo / editar modelo --%>
      <div class="p-6 max-w-lg">
        <h2 class="text-base font-semibold text-gray-800 mb-5">
          <%= if @modelo, do: "Editar modelo", else: "Nuevo modelo" %>
        </h2>
        <.form for={@modelo_form} phx-submit="guardar_modelo" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Nombre <span class="text-xs text-gray-400 font-normal">(técnico, sin espacios)</span>
            </label>
            <.input field={@modelo_form[:nombre]} placeholder="ej. socios" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
            <.input field={@modelo_form[:descripcion]} placeholder="ej. Catálogo de socios" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Tabla en BD <span class="text-xs text-gray-400 font-normal">(nombre real en PostgreSQL)</span>
            </label>
            <.input field={@modelo_form[:tabla_db]} placeholder="ej. socios" />
          </div>
          <div class="flex gap-3 pt-2">
            <button type="submit"
              class="px-4 py-2 bg-indigo-600 text-white text-sm rounded hover:bg-indigo-700">
              Guardar
            </button>
            <button type="button" phx-click="cancelar"
              class="px-4 py-2 text-sm text-gray-500 hover:text-gray-700">
              Cancelar
            </button>
          </div>
        </.form>
      </div>

    <% else %>
      <%= if @modelo do %>
        <%!-- Cabecera del modelo --%>
        <div class="px-6 py-4 border-b border-gray-200 flex items-start justify-between shrink-0 gap-4">
          <div class="min-w-0">
            <div class="flex items-center gap-3">
              <h2 class="text-base font-semibold text-gray-800"><%= @modelo.nombre %></h2>
              <%!-- Badge estado BD --%>
              <%= cond do %>
                <% MapSet.member?(@local_ids, @modelo.id) -> %>
                  <span class="flex items-center gap-1 px-2 py-0.5 bg-yellow-50 text-yellow-700 text-xs rounded-full border border-yellow-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-yellow-400"></span>
                    Borrador local
                  </span>
                <% @modelo.tabla_creada -> %>
                  <span class="flex items-center gap-1 px-2 py-0.5 bg-green-50 text-green-700 text-xs rounded-full border border-green-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                    BD activa
                  </span>
                <% true -> %>
                  <span class="flex items-center gap-1 px-2 py-0.5 bg-amber-50 text-amber-700 text-xs rounded-full border border-amber-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    Sin tabla
                  </span>
              <% end %>
            </div>
            <p class="text-xs text-gray-500 mt-0.5">
              tabla: <code class="bg-gray-100 px-1 rounded"><%= @modelo.tabla_db %></code>
              <%= if @modelo.descripcion do %>
                &nbsp;·&nbsp;<%= @modelo.descripcion %>
              <% end %>
            </p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <%!-- Botón Ejecutar migración (solo si tabla no creada) --%>
            <%= if not @modelo.tabla_creada do %>
              <button phx-click="crear_tabla_bd" disabled={@bd_creando}
                class={[
                  "px-3 py-1.5 text-sm rounded font-medium transition-colors",
                  @bd_creando &&
                    "bg-gray-100 text-gray-400 cursor-not-allowed" ||
                    "bg-green-600 text-white hover:bg-green-700"
                ]}>
                <%= if @bd_creando, do: "Creando...", else: "Ejecutar migración" %>
              </button>
            <% end %>
            <%!-- Botón Aplicar cambios de columnas pendientes --%>
            <% cols_pendientes = Enum.filter(@modelo.columnas, &MapSet.member?(@col_local_ids, &1.id)) %>
            <%= if cols_pendientes != [] do %>
              <button phx-click="agregar_cols_bd"
                class="px-3 py-1.5 text-sm rounded font-medium bg-yellow-500 text-white hover:bg-yellow-600 transition-colors">
                Aplicar <%= length(cols_pendientes) %> cambio(s)
              </button>
            <% end %>
            <button phx-click="editar_modelo"
              class="text-sm text-indigo-600 hover:text-indigo-800">Editar</button>
            <button
              phx-click="eliminar_modelo"
              data-confirm={"¿Eliminar el modelo '#{@modelo.nombre}'? Se eliminarán también sus columnas y endpoints."}
              class="text-sm text-red-400 hover:text-red-600">Eliminar</button>
          </div>
        </div>

        <%!-- Confirmación renombrar tabla --%>
        <%= if @confirm_rename do %>
          <div class="mx-6 mt-3 px-4 py-3 rounded border border-amber-300 bg-amber-50 flex items-center justify-between gap-4">
            <div class="text-sm text-amber-800">
              <span class="font-semibold">¿Renombrar tabla en PostgreSQL?</span>
              &nbsp;
              <code class="bg-amber-100 px-1 rounded"><%= @confirm_rename.old %></code>
              &nbsp;→&nbsp;
              <code class="bg-amber-100 px-1 rounded"><%= @confirm_rename.new %></code>
              <span class="ml-1 text-amber-600">· Se ejecutará <strong>ALTER TABLE RENAME</strong>, los datos existentes se conservan.</span>
            </div>
            <div class="flex gap-2 shrink-0">
              <button phx-click="confirmar_renombrar"
                class="px-3 py-1.5 text-sm rounded font-medium bg-amber-600 text-white hover:bg-amber-700">
                Confirmar
              </button>
              <button phx-click="cancelar_renombrar"
                class="px-3 py-1.5 text-sm rounded font-medium bg-white border border-gray-300 text-gray-600 hover:bg-gray-50">
                Cancelar
              </button>
            </div>
          </div>
        <% end %>

        <%!-- Mensaje BD --%>
        <%= if @bd_mensaje do %>
          <% {tipo, msg} = @bd_mensaje %>
          <div class={[
            "mx-6 mt-3 px-4 py-2.5 rounded text-sm",
            tipo == :ok && "bg-green-50 text-green-700 border border-green-200" ||
                           "bg-red-50 text-red-700 border border-red-200"
          ]}>
            <%= msg %>
          </div>
        <% end %>

        <%!-- Tabs --%>
        <div class="px-6 border-b border-gray-200 shrink-0 mt-1">
          <nav class="flex gap-1 -mb-px">
            <button phx-click="cambiar_tab" phx-value-tab="columnas"
              class={tab_class(@tab == :columnas)}>
              Columnas (<%= length(@modelo.columnas) %>)
            </button>
            <button phx-click="cambiar_tab" phx-value-tab="endpoints"
              class={tab_class(@tab == :endpoints)}>
              Endpoints (<%= length(@modelo.endpoints) %>)
            </button>
            <button phx-click="cambiar_tab" phx-value-tab="relaciones"
              class={tab_class(@tab == :relaciones)}>
              Relaciones (<%= length(@modelo.relaciones) %>)
            </button>
          </nav>
        </div>

        <%!-- Contenido --%>
        <div class="p-6 flex-1">
          <%= cond do %>
            <% @tab == :columnas -> %>
              <div class="mb-4 flex justify-end">
                <button phx-click="nueva_col"
                  class="px-3 py-1.5 bg-indigo-600 text-white text-sm rounded hover:bg-indigo-700">
                  + Nueva columna
                </button>
              </div>

              <div class="overflow-x-auto rounded border border-gray-200">
                <table class="min-w-full text-sm">
                  <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
                    <tr>
                      <th class="px-2 py-2 w-20"></th>
                      <th class="px-3 py-2 text-left">Nombre</th>
                      <th class="px-3 py-2 text-left">Etiqueta</th>
                      <th class="px-3 py-2 text-left">Tipo</th>
                      <th class="px-3 py-2 text-center w-12">Null</th>
                      <th class="px-3 py-2 text-center w-12">Req</th>
                      <th class="px-3 py-2 text-center w-12">Único</th>
                      <th class="px-3 py-2 text-left w-20">Min/Max</th>
                      <th class="px-3 py-2 w-28"></th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    <%= if @modelo.columnas == [] do %>
                      <tr>
                        <td colspan="9" class="px-4 py-8 text-center text-gray-400 text-sm">
                          Sin columnas. Presiona "+ Nueva columna".
                        </td>
                      </tr>
                    <% else %>
                      <% sorted = Enum.sort_by(@modelo.columnas, & &1.orden) %>
                      <% last = length(sorted) - 1 %>
                      <%= for {col, idx} <- Enum.with_index(sorted) do %>
                        <tr class={["hover:bg-gray-50", @col_editando_id == col.id && "bg-indigo-50" || ""]}>
                          <td class="px-2 py-2">
                            <div class="flex items-center gap-1">
                              <button
                                phx-click="mover_col" phx-value-id={col.id} phx-value-dir="up"
                                class={[
                                  "px-1.5 py-0.5 rounded text-xs bg-gray-100 hover:bg-gray-200",
                                  idx == 0 && "opacity-30 pointer-events-none" || ""
                                ]}>
                                ↑
                              </button>
                              <button
                                phx-click="mover_col" phx-value-id={col.id} phx-value-dir="down"
                                class={[
                                  "px-1.5 py-0.5 rounded text-xs bg-gray-100 hover:bg-gray-200",
                                  idx == last && "opacity-30 pointer-events-none" || ""
                                ]}>
                                ↓
                              </button>
                            </div>
                          </td>
                          <td class="px-3 py-2 font-mono text-gray-800 text-xs">
                            <div class="flex items-center gap-1.5">
                              <%= col.nombre %>
                              <%= if MapSet.member?(@col_local_ids, col.id) do %>
                                <span title="Pendiente de agregar a BD" class="w-1.5 h-1.5 rounded-full bg-yellow-400 shrink-0"></span>
                              <% end %>
                            </div>
                          </td>
                          <td class="px-3 py-2 text-gray-600 text-xs"><%= col.etiqueta %></td>
                          <td class="px-3 py-2">
                            <span class="px-2 py-0.5 bg-blue-50 text-blue-700 rounded text-xs font-medium">
                              <%= col.tipo %><%= if col.longitud, do: "(#{col.longitud})" %>
                            </span>
                          </td>
                          <td class="px-3 py-2 text-center text-xs">
                            <%= if col.nullable, do: "✓", else: "✗" %>
                          </td>
                          <td class="px-3 py-2 text-center text-xs">
                            <%= if col.requerido do %>
                              <span class="text-orange-500">✓</span>
                            <% else %>
                              <span class="text-gray-300">–</span>
                            <% end %>
                          </td>
                          <td class="px-3 py-2 text-center text-xs">
                            <%= if col.unico do %>
                              <span class="text-purple-500">U</span>
                            <% else %>
                              <span class="text-gray-300">–</span>
                            <% end %>
                          </td>
                          <td class="px-3 py-2 text-gray-400 text-xs">
                            <%= if col.min_longitud || col.max_longitud do %>
                              <%= col.min_longitud %>/<%= col.max_longitud %>
                            <% else %>
                              –
                            <% end %>
                          </td>
                          <td class="px-3 py-2">
                            <div class="flex gap-2 justify-end">
                              <button phx-click="editar_col" phx-value-id={col.id}
                                class="text-indigo-500 hover:text-indigo-700 text-xs">Editar</button>
                              <button
                                phx-click="eliminar_col" phx-value-id={col.id}
                                data-confirm={"¿Eliminar columna '#{col.nombre}'?"}
                                class="text-red-400 hover:text-red-600 text-xs">Borrar</button>
                            </div>
                          </td>
                        </tr>
                      <% end %>
                    <% end %>
                  </tbody>
                </table>
              </div>

              <%!-- Formulario de columna --%>
              <%= if @col_form do %>
                <div class="mt-5 p-5 bg-gray-50 rounded border border-gray-200">
                  <h3 class="text-sm font-semibold text-gray-700 mb-4">
                    <%= if @col_editando_id, do: "Editar columna", else: "Nueva columna" %>
                  </h3>
                  <.form for={@col_form} phx-submit="guardar_col" class="grid grid-cols-3 gap-4">
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">Nombre</label>
                      <.input field={@col_form[:nombre]} placeholder="ej. nombre_cliente" />
                    </div>
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">Etiqueta</label>
                      <.input field={@col_form[:etiqueta]} placeholder="ej. Nombre del cliente" />
                    </div>
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">Tipo</label>
                      <.input type="select" field={@col_form[:tipo]}
                        options={MetaColumn.tipos()} />
                    </div>
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">Longitud</label>
                      <.input type="number" field={@col_form[:longitud]} placeholder="ej. 255" />
                    </div>
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">Orden</label>
                      <.input type="number" field={@col_form[:orden]} />
                    </div>
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">Valor default</label>
                      <.input field={@col_form[:default_value]} placeholder="ej. pendiente" />
                    </div>
                    <div class="flex items-end pb-1"></div>
                    <div class="col-span-3 flex items-center gap-6 pt-1">
                      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                        <.input type="checkbox" field={@col_form[:nullable]} /> Nullable
                      </label>
                      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                        <.input type="checkbox" field={@col_form[:es_pk]} /> Es PK
                      </label>
                      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                        <.input type="checkbox" field={@col_form[:requerido]} /> Requerido
                      </label>
                      <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                        <.input type="checkbox" field={@col_form[:unico]} /> Único
                      </label>
                    </div>
                    <div class="col-span-3 flex gap-3 pt-1">
                      <button type="submit"
                        class="px-4 py-2 bg-indigo-600 text-white text-sm rounded hover:bg-indigo-700">
                        Guardar columna
                      </button>
                      <button type="button" phx-click="cancelar"
                        class="px-4 py-2 text-sm text-gray-500 hover:text-gray-700">
                        Cancelar
                      </button>
                    </div>
                  </.form>
                </div>
              <% end %>

            <% @tab == :endpoints -> %>
              <%!-- Tab: Endpoints --%>
              <p class="text-xs text-gray-400 mb-4">
                Activa las operaciones que expone este modelo como API.
                La URL base será <code class="bg-gray-100 px-1 rounded">/api/dyn/<%= @modelo.nombre %></code>
              </p>
              <div class="space-y-2 max-w-lg">
                <%= for op <- Prettycore.Meta.MetaEndpoint.operaciones() do %>
                  <% activo = Enum.any?(@modelo.endpoints, &(&1.operacion == op)) %>
                  <div class={[
                    "flex items-center justify-between p-3 rounded border transition-colors",
                    activo && "bg-indigo-50 border-indigo-200" || "bg-white border-gray-200"
                  ]}>
                    <div>
                      <span class="font-mono text-sm font-medium text-gray-800"><%= op %></span>
                      <span class="ml-3 text-xs text-gray-400 font-mono"><%= endpoint_desc(op) %></span>
                    </div>
                    <button
                      phx-click="toggle_endpoint" phx-value-operacion={op}
                      class={[
                        "px-3 py-1 text-xs rounded font-medium transition-colors",
                        activo &&
                          "bg-indigo-600 text-white hover:bg-red-500" ||
                          "bg-gray-100 text-gray-600 hover:bg-indigo-100"
                      ]}
                    >
                      <%= if activo, do: "Activo", else: "Inactivo" %>
                    </button>
                  </div>
                <% end %>
              </div>

            <% @tab == :relaciones -> %>
              <%!-- Tab: Relaciones --%>
              <div class="mb-4 flex items-center justify-between">
                <p class="text-xs text-gray-400">
                  Define cómo se relaciona este modelo con otros esquema del diseñador.
                </p>
                <button phx-click="nueva_relacion"
                  class="px-3 py-1.5 bg-indigo-600 text-white text-sm rounded hover:bg-indigo-700">
                  + Nueva relación
                </button>
              </div>

              <div class="overflow-x-auto rounded border border-gray-200 mb-5">
                <table class="min-w-full text-sm">
                  <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
                    <tr>
                      <th class="px-3 py-2 text-left">Tipo</th>
                      <th class="px-3 py-2 text-left">Modelo destino</th>
                      <th class="px-3 py-2 text-left">Campo FK</th>
                      <th class="px-3 py-2 text-left">Alias</th>
                      <th class="px-3 py-2 w-16"></th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    <%= if @modelo.relaciones == [] do %>
                      <tr>
                        <td colspan="5" class="px-4 py-8 text-center text-gray-400 text-sm">
                          Sin relaciones definidas.
                        </td>
                      </tr>
                    <% else %>
                      <%= for rel <- @modelo.relaciones do %>
                        <tr class="hover:bg-gray-50">
                          <td class="px-3 py-2">
                            <span class={[
                              "px-2 py-0.5 rounded text-xs font-medium",
                              rel.tipo == "belongs_to" && "bg-orange-50 text-orange-700" ||
                                                          "bg-teal-50 text-teal-700"
                            ]}>
                              <%= rel.tipo %>
                            </span>
                          </td>
                          <td class="px-3 py-2 font-mono text-xs text-gray-700">
                            <%= if rel.destino, do: rel.destino.nombre, else: rel.modelo_destino_id %>
                          </td>
                          <td class="px-3 py-2 font-mono text-xs text-gray-600"><%= rel.campo_fk %></td>
                          <td class="px-3 py-2 text-xs text-gray-500"><%= rel.alias %></td>
                          <td class="px-3 py-2 text-right">
                            <button
                              phx-click="eliminar_relacion" phx-value-id={rel.id}
                              data-confirm="¿Eliminar esta relación?"
                              class="text-red-400 hover:text-red-600 text-xs">Borrar</button>
                          </td>
                        </tr>
                      <% end %>
                    <% end %>
                  </tbody>
                </table>
              </div>

              <%!-- Formulario nueva relación --%>
              <%= if @rel_form do %>
                <div class="p-5 bg-gray-50 rounded border border-gray-200 max-w-xl">
                  <h3 class="text-sm font-semibold text-gray-700 mb-4">Nueva relación</h3>
                  <.form for={@rel_form} phx-submit="guardar_relacion" class="grid grid-cols-2 gap-4">
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">Tipo</label>
                      <.input type="select" field={@rel_form[:tipo]}
                        options={MetaRelation.tipos()} />
                    </div>
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">Modelo destino</label>
                      <.input type="select" field={@rel_form[:modelo_destino_id]}
                        options={Enum.map(@esquema, &{&1.nombre, &1.id})} />
                    </div>
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">Campo FK</label>
                      <.input field={@rel_form[:campo_fk]} placeholder="ej. cliente_id" />
                    </div>
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">Alias (opcional)</label>
                      <.input field={@rel_form[:alias]} placeholder="ej. cliente" />
                    </div>
                    <div class="col-span-2 flex gap-3 pt-1">
                      <button type="submit"
                        class="px-4 py-2 bg-indigo-600 text-white text-sm rounded hover:bg-indigo-700">
                        Guardar relación
                      </button>
                      <button type="button" phx-click="cancelar"
                        class="px-4 py-2 text-sm text-gray-500 hover:text-gray-700">
                        Cancelar
                      </button>
                    </div>
                  </.form>
                </div>
              <% end %>

          <% end %>
        </div>

      <% else %>
        <%!-- Estado vacío --%>
        <div class="flex-1 flex items-center justify-center h-full">
          <div class="text-center text-gray-400">
            <div class="text-4xl mb-3">⚙️</div>
            <p class="text-sm">Selecciona un modelo o crea uno nuevo</p>
          </div>
        </div>
      <% end %>
    <% end %>

  </main>
</div>
