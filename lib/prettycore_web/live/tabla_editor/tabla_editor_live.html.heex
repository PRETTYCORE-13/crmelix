<div class="flex h-[calc(100vh-4rem)] bg-gray-50 overflow-hidden">

  <%!-- Sidebar izquierdo: lista de tablas --%>
  <aside class="w-56 shrink-0 border-r border-gray-200 bg-white flex flex-col">
    <div class="px-4 py-3 border-b border-gray-200">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Tablas</p>
    </div>
    <nav class="flex-1 overflow-y-auto">
      <%= if @tablas == [] do %>
        <p class="px-4 py-8 text-xs text-gray-400 text-center leading-relaxed">
          No hay tablas creadas.<br/>
          Ve al Diseñador para crear una.
        </p>
      <% else %>
        <%= for t <- @tablas do %>
          <button
            phx-click="seleccionar_tabla"
            phx-value-id={t.id}
            class={[
              "w-full text-left px-4 py-2.5 border-b border-gray-100 hover:bg-indigo-50 transition-colors",
              @tabla_sel && @tabla_sel.id == t.id &&
                "bg-indigo-50 border-l-2 border-l-indigo-500" || ""
            ]}
          >
            <div class={["text-sm font-medium truncate",
              @tabla_sel && @tabla_sel.id == t.id && "text-indigo-700" || "text-gray-800"]}>
              <%= t.nombre %>
            </div>
            <div class="text-xs text-gray-400 truncate"><%= t.tabla_db %></div>
          </button>
        <% end %>
      <% end %>
    </nav>
  </aside>

  <%!-- Panel principal --%>
  <main class="flex-1 flex flex-col min-w-0 overflow-hidden">

    <%= if @tabla_sel do %>

      <%!-- Cabecera --%>
      <div class="px-6 py-3 bg-white border-b border-gray-200 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
          <div>
            <h1 class="text-base font-semibold text-gray-900"><%= @tabla_sel.nombre %></h1>
            <p class="text-xs text-gray-400"><%= @tabla_sel.tabla_db %> · <%= length(@filas) %> fila(s)</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <%!-- Recargar --%>
          <button phx-click="recargar"
            class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded transition-colors"
            title="Recargar datos">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
          </button>
          <%!-- Insertar --%>
          <button phx-click="abrir_form"
            class="flex items-center gap-1.5 px-3 py-1.5 bg-indigo-600 text-white text-sm font-medium rounded hover:bg-indigo-700 transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            Insertar fila
          </button>
        </div>
      </div>

      <%!-- Error --%>
      <%= if @error do %>
        <div class="mx-6 mt-3 px-4 py-2.5 bg-red-50 border border-red-200 rounded text-sm text-red-700">
          <%= @error %>
        </div>
      <% end %>

      <%!-- Tabla de datos --%>
      <div class="flex-1 overflow-auto">
        <%= if @filas == [] do %>
          <div class="flex flex-col items-center justify-center h-full text-gray-400 gap-2">
            <svg class="w-10 h-10 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M3 10h18M3 6h18M3 14h18M3 18h18"/>
            </svg>
            <p class="text-sm">Sin filas. Presiona <strong>Insertar fila</strong> para agregar datos.</p>
          </div>
        <% else %>
          <table class="w-full text-sm border-collapse">
            <thead class="sticky top-0 z-10">
              <tr class="bg-gray-900 text-gray-300 text-xs uppercase tracking-wide">
                <th class="px-3 py-2.5 text-left font-medium w-36 border-r border-gray-700">id</th>
                <%= for col <- @cols_def do %>
                  <th class="px-3 py-2.5 text-left font-medium border-r border-gray-700">
                    <%= col.nombre %>
                    <span class="ml-1 text-gray-500 font-normal normal-case"><%= col.tipo %></span>
                  </th>
                <% end %>
                <th class="px-3 py-2.5 text-left font-medium w-40 border-r border-gray-700">inserted_at</th>
                <th class="px-3 py-2.5 w-10"></th>
              </tr>
            </thead>
            <tbody>
              <%= for fila <- @filas do %>
                <tr class="bg-white border-b border-gray-100 hover:bg-indigo-50/40 group transition-colors">
                  <%!-- id (UUID abreviado) --%>
                  <td class="px-3 py-2 text-gray-400 font-mono text-xs truncate w-36" title={fila[:id]}>
                    <%= if fila[:id], do: String.slice(to_string(fila[:id]), 0, 8) <> "…", else: "—" %>
                  </td>
                  <%!-- columnas de usuario --%>
                  <%= for col <- @cols_def do %>
                    <td class="px-3 py-2 text-gray-800 max-w-xs truncate" title={to_string(fila[String.to_atom(col.nombre)])}>
                      <%= case fila[String.to_atom(col.nombre)] do %>
                        <% nil   -> %><span class="text-gray-300 italic">null</span>
                        <% ""    -> %><span class="text-gray-300 italic">vacío</span>
                        <% val  -> %><%= val %>
                      <% end %>
                    </td>
                  <% end %>
                  <%!-- inserted_at --%>
                  <td class="px-3 py-2 text-gray-400 text-xs w-40">
                    <%= fila[:inserted_at] || "—" %>
                  </td>
                  <%!-- Borrar --%>
                  <td class="px-3 py-2 w-10 text-center">
                    <button
                      phx-click="borrar_fila"
                      phx-value-id={fila[:id]}
                      data-confirm="¿Borrar esta fila? Esta acción no se puede deshacer."
                      class="opacity-0 group-hover:opacity-100 p-1 text-red-400 hover:text-red-600 hover:bg-red-50 rounded transition-all"
                      title="Borrar fila">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    </button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>

    <% else %>
      <%!-- Estado vacío: ninguna tabla seleccionada --%>
      <div class="flex-1 flex flex-col items-center justify-center text-gray-400 gap-3">
        <svg class="w-14 h-14 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7M4 7c0-2 1-3 3-3h10c2 0 3 1 3 3M4 7h16M9 3v4M15 3v4"/>
        </svg>
        <p class="text-sm">Selecciona una tabla de la lista para ver sus datos.</p>
      </div>
    <% end %>

  </main>

</div>

<%!-- Modal: Insertar fila --%>
<%= if @form_abierto do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40" phx-click="cerrar_form"></div>
    <div class="relative bg-white rounded-xl shadow-2xl w-full max-w-md overflow-hidden">

      <%!-- Header --%>
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
        <div>
          <h2 class="text-base font-semibold text-gray-900">Nueva fila</h2>
          <p class="text-xs text-gray-400 mt-0.5"><%= @tabla_sel && @tabla_sel.tabla_db %></p>
        </div>
        <button phx-click="cerrar_form" class="p-1.5 text-gray-400 hover:text-gray-600 rounded">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <%!-- Formulario --%>
      <form phx-submit="insertar" phx-change="form_change" class="overflow-y-auto max-h-[60vh]">
        <div class="px-6 py-4 space-y-4">
          <%= if @error do %>
            <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded px-3 py-2"><%= @error %></p>
          <% end %>

          <%= for col <- @cols_def do %>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">
                <%= col.etiqueta || col.nombre %>
                <span class="ml-1 text-xs text-gray-400 font-normal">(<%= col.tipo %>)</span>
                <%= if col.requerido do %>
                  <span class="text-red-500 ml-0.5">*</span>
                <% end %>
              </label>

              <%= case tipo_input(col.tipo) do %>
                <% "textarea" -> %>
                  <textarea
                    name={"fila[#{col.nombre}]"}
                    rows="3"
                    class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none resize-none"
                    placeholder={col.etiqueta || col.nombre}
                  ><%= Map.get(@form_attrs, col.nombre, "") %></textarea>
                <% tipo -> %>
                  <input
                    type={tipo}
                    name={"fila[#{col.nombre}]"}
                    value={Map.get(@form_attrs, col.nombre, "")}
                    class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none"
                    placeholder={col.etiqueta || col.nombre}
                  />
              <% end %>
            </div>
          <% end %>
        </div>

        <%!-- Footer --%>
        <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-100 bg-gray-50">
          <button type="button" phx-click="cerrar_form"
            class="px-4 py-2 text-sm text-gray-500 hover:text-gray-700 transition-colors">
            Cancelar
          </button>
          <button type="submit"
            class="px-5 py-2 bg-indigo-600 text-white text-sm font-medium rounded hover:bg-indigo-700 transition-colors">
            Guardar fila
          </button>
        </div>
      </form>

    </div>
  </div>
<% end %>
